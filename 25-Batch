<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Room Entry • Batch 25</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-base: #05070e;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-primary: #38bdf8;
      --accent-secondary: #818cf8;
      --accent-emerald: #34d399;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      min-height: 100vh;
      background-color: var(--bg-base);
      background-image:
        radial-gradient(circle at 12% 18%, rgba(56, 189, 248, 0.22) 0%, transparent 42%),
        radial-gradient(circle at 88% 22%, rgba(129, 140, 248, 0.20) 0%, transparent 45%),
        radial-gradient(circle at 50% 88%, rgba(168, 85, 247, 0.18) 0%, transparent 48%),
        linear-gradient(180deg, #05070e 0%, #0a0f1d 100%);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text-main);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px 18px;
      overflow: hidden;
      perspective: 1400px;
      position: relative;
      -webkit-font-smoothing: antialiased;
    }

    /* Ambient 3D Spheres */
    .ambient-scene {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .sphere {
      position: absolute;
      border-radius: 50%;
      animation: floatSphere 14s ease-in-out infinite alternate;
    }

    .sphere-1 {
      width: 210px;
      height: 210px;
      top: 8%;
      left: calc(50% - 260px);
      background: radial-gradient(circle at 30% 28%, #bae6fd, #0284c7 52%, #082f49 92%);
      box-shadow:
        inset -20px -20px 40px rgba(0, 0, 0, 0.7),
        inset 14px 14px 28px rgba(255, 255, 255, 0.55),
        0 30px 70px rgba(2, 132, 199, 0.35);
    }

    .sphere-2 {
      width: 155px;
      height: 155px;
      bottom: 9%;
      right: calc(50% - 240px);
      background: radial-gradient(circle at 32% 28%, #e9d5ff, #7c3aed 55%, #2e1065 92%);
      box-shadow:
        inset -16px -16px 32px rgba(0, 0, 0, 0.7),
        inset 10px 10px 22px rgba(255, 255, 255, 0.45),
        0 25px 60px rgba(124, 58, 237, 0.35);
      animation-delay: -6s;
      animation-duration: 17s;
    }

    @keyframes floatSphere {
      0% { transform: translate3d(0, 0, 0) scale(1); }
      50% { transform: translate3d(14px, -20px, 30px) scale(1.04); }
      100% { transform: translate3d(-10px, 14px, -15px) scale(0.97); }
    }

    /* Main 3D Spatial Glass Card */
    .card-stage {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 400px;
      transform-style: preserve-3d;
      transition: transform 0.25s cubic-bezier(0.2, 0.85, 0.4, 1);
    }

    .card-stage::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: 34px;
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.4), rgba(255, 255, 255, 0.04) 50%, rgba(168, 85, 247, 0.38));
      z-index: -1;
      filter: blur(22px);
      opacity: 0.55;
      transform: translateZ(-25px);
    }

    .glass-panel {
      position: relative;
      background: linear-gradient(150deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.035) 100%);
      backdrop-filter: blur(32px) saturate(200%);
      -webkit-backdrop-filter: blur(32px) saturate(200%);
      border-radius: 32px;
      padding: 38px 30px 34px;
      border-top: 1.5px solid rgba(255, 255, 255, 0.38);
      border-left: 1.5px solid rgba(255, 255, 255, 0.24);
      border-right: 1.5px solid rgba(255, 255, 255, 0.08);
      border-bottom: 2px solid rgba(0, 0, 0, 0.5);
      box-shadow:
        0 32px 64px -12px rgba(0, 0, 0, 0.75),
        0 14px 28px -8px rgba(0, 0, 0, 0.55),
        inset 0 1px 2px rgba(255, 255, 255, 0.4),
        inset 0 -10px 24px rgba(0, 0, 0, 0.28);
      transform-style: preserve-3d;
      overflow: hidden;
    }

    /* Specular Glass Glare */
    .glass-panel::after {
      content: "";
      position: absolute;
      top: -60%;
      left: -60%;
      width: 220%;
      height: 220%;
      background: linear-gradient(
        118deg,
        transparent 38%,
        rgba(255, 255, 255, 0.05) 47%,
        rgba(255, 255, 255, 0.13) 50%,
        rgba(255, 255, 255, 0.05) 53%,
        transparent 62%
      );
      transform: rotate(-14deg);
      pointer-events: none;
    }

    /* Header */
    .header {
      text-align: center;
      margin-bottom: 26px;
      transform: translateZ(26px);
    }

    .icon-3d-wrap {
      width: 74px;
      height: 74px;
      margin: 0 auto 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 24px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.04));
      border-top: 1.5px solid rgba(255, 255, 255, 0.5);
      border-left: 1.5px solid rgba(255, 255, 255, 0.3);
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 3px solid rgba(0, 0, 0, 0.45);
      box-shadow:
        0 16px 28px rgba(0, 0, 0, 0.45),
        0 5px 0 rgba(30, 41, 59, 0.75),
        inset 0 2px 4px rgba(255, 255, 255, 0.4);
      animation: floatIcon 4s ease-in-out infinite;
    }

    @keyframes floatIcon {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }

    .title {
      font-family: 'Outfit', sans-serif;
      font-size: 25px;
      font-weight: 700;
      letter-spacing: -0.02em;
      background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      line-height: 1.45;
    }

    /* Form */
    form {
      transform: translateZ(20px);
    }

    .field {
      margin-bottom: 20px;
    }

    .label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #e2e8f0;
      margin-bottom: 8px;
      padding-left: 4px;
      letter-spacing: 0.01em;
    }

    /* Recessed 3D Input Well */
    .input-well {
      display: flex;
      align-items: center;
      border-radius: 18px;
      background: rgba(8, 12, 24, 0.65);
      border-top: 1.5px solid rgba(0, 0, 0, 0.7);
      border-left: 1.5px solid rgba(0, 0, 0, 0.55);
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1.5px solid rgba(255, 255, 255, 0.2);
      box-shadow:
        inset 0 4px 10px rgba(0, 0, 0, 0.7),
        inset 0 1px 2px rgba(0, 0, 0, 0.85),
        0 2px 4px rgba(255, 255, 255, 0.04);
      transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .input-well:focus-within {
      background: rgba(14, 21, 38, 0.82);
      border-color: rgba(56, 189, 248, 0.6);
      box-shadow:
        inset 0 3px 8px rgba(0, 0, 0, 0.55),
        0 0 0 4px rgba(56, 189, 248, 0.15),
        0 10px 24px -6px rgba(56, 189, 248, 0.25);
      transform: translateY(-1.5px);
    }

    .icon-tile {
      width: 44px;
      height: 44px;
      margin-left: 6px;
      border-radius: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.02));
      border-top: 1px solid rgba(255, 255, 255, 0.26);
      border-bottom: 2px solid rgba(0, 0, 0, 0.45);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.32);
      flex-shrink: 0;
      transition: transform 0.25s ease, background 0.25s ease;
    }

    .input-well:focus-within .icon-tile {
      transform: scale(1.05);
      background: linear-gradient(145deg, rgba(56, 189, 248, 0.28), rgba(129, 140, 248, 0.16));
      border-top-color: rgba(186, 230, 253, 0.55);
    }

    .input-well input {
      width: 100%;
      background: transparent;
      border: none;
      outline: none;
      padding: 15px 16px 15px 12px;
      font-size: 15px;
      font-weight: 500;
      color: #ffffff;
      font-family: inherit;
    }

    .input-well input::placeholder {
      color: #64748b;
      font-weight: 400;
    }

    /* 3D Tactile Button */
    .btn-submit {
      margin-top: 10px;
      position: relative;
      width: 100%;
      border: none;
      outline: none;
      cursor: pointer;
      border-radius: 18px;
      padding: 16px 24px;
      font-family: 'Inter', sans-serif;
      font-size: 15.5px;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: #ffffff;
      background: linear-gradient(135deg, #38bdf8 0%, #6366f1 55%, #8b5cf6 100%);
      border-top: 1.5px solid rgba(255, 255, 255, 0.55);
      border-left: 1px solid rgba(255, 255, 255, 0.35);
      border-right: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow:
        0 6px 0 #312e81,
        0 14px 28px rgba(79, 70, 229, 0.45),
        inset 0 2px 2px rgba(255, 255, 255, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: transform 0.14s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.14s ease, filter 0.2s ease;
    }

    .btn-submit:hover {
      filter: brightness(1.07);
      transform: translateY(-2px);
      box-shadow:
        0 8px 0 #312e81,
        0 18px 34px rgba(79, 70, 229, 0.55),
        inset 0 2px 3px rgba(255, 255, 255, 0.5);
    }

    .btn-submit:active {
      transform: translateY(4px);
      box-shadow:
        0 2px 0 #312e81,
        0 6px 14px rgba(79, 70, 229, 0.35),
        inset 0 1px 2px rgba(255, 255, 255, 0.3);
    }

    .btn-submit:disabled {
      opacity: 0.75;
      cursor: wait;
      transform: translateY(3px);
      box-shadow: 0 3px 0 #312e81, 0 8px 16px rgba(0, 0, 0, 0.3);
    }

    /* 3D Minimal Thank You Overlay */
    .success-modal {
      position: absolute;
      inset: 0;
      background: rgba(8, 12, 24, 0.92);
      backdrop-filter: blur(26px);
      -webkit-backdrop-filter: blur(26px);
      border-radius: 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transform: scale(0.92);
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      z-index: 20;
    }

    .success-modal.active {
      opacity: 1;
      pointer-events: auto;
      transform: scale(1);
    }

    .success-badge {
      width: 80px;
      height: 80px;
      border-radius: 26px;
      background: linear-gradient(135deg, rgba(52, 211, 153, 0.25), rgba(16, 185, 129, 0.08));
      border-top: 1.5px solid rgba(110, 231, 183, 0.6);
      border-bottom: 3px solid rgba(6, 78, 59, 0.85);
      box-shadow:
        0 14px 28px rgba(16, 185, 129, 0.28),
        0 5px 0 #065f46,
        inset 0 2px 4px rgba(255, 255, 255, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .success-title {
      font-family: 'Outfit', sans-serif;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.01em;
      background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .spinner {
      width: 18px;
      height: 18px;
      border: 2.5px solid rgba(255, 255, 255, 0.3);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: none;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <div class="ambient-scene">
    <div class="sphere sphere-1"></div>
    <div class="sphere sphere-2"></div>
  </div>

  <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;"></iframe>

  <div class="card-stage" id="tiltCard">
    <div class="glass-panel">
      
      <div class="header">
        <div class="icon-3d-wrap">
          <svg width="42" height="42" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="cardGrad" x1="10" y1="8" x2="54" y2="56" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#38BDF8" />
                <stop offset="50%" stop-color="#818CF8" />
                <stop offset="100%" stop-color="#C084FC" />
              </linearGradient>
              <linearGradient id="shineGrad" x1="12" y1="10" x2="40" y2="42" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.7" />
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.05" />
              </linearGradient>
            </defs>
            <rect x="12" y="14" width="40" height="42" rx="10" fill="#1E1B4B" />
            <rect x="12" y="10" width="40" height="42" rx="10" fill="url(#cardGrad)" stroke="url(#shineGrad)" stroke-width="2" />
            <rect x="26" y="15" width="12" height="3.5" rx="1.75" fill="#0F172A" opacity="0.65" />
            <circle cx="32" cy="28" r="6" fill="#FFFFFF" opacity="0.95" />
            <path d="M22 42C22 37.5817 26.4772 34 32 34C37.5228 34 42 37.5817 42 42" stroke="#FFFFFF" stroke-width="3.2" stroke-linecap="round" opacity="0.95" />
          </svg>
        </div>
        <h1 class="title">Room Entry</h1>
        <p class="subtitle">Batch 25 Hostellers • Enter your name &amp; room number</p>
      </div>

      <form 
        id="googleForm"
        action="https://docs.google.com/forms/d/e/1FAIpQLSd6o9ChKH3JWN4NF7MzKtjhCGrd83ksCIkOGuOrU1IpsKkf4Q/formResponse" 
        method="POST" 
        target="hidden_iframe"
      >
        <div class="field">
          <label class="label" for="userName">Name *</label>
          <div class="input-well">
            <div class="icon-tile">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="8" r="4" stroke="#38BDF8" stroke-width="2"/>
                <path d="M5 20C5 16.6863 8.13401 14 12 14C15.866 14 19 16.6863 19 20" stroke="#818CF8" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <input 
              type="text" 
              id="userName"
              name="entry.1875663334" 
              placeholder="Enter your name" 
              autocomplete="name"
              required 
            />
          </div>
        </div>

        <div class="field">
          <label class="label" for="userRoom">Room No *</label>
          <div class="input-well">
            <div class="icon-tile">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M5 21V5C5 3.89543 5.89543 3 7 3H15C16.1046 3 17 3.89543 17 5V21" stroke="#C084FC" stroke-width="2" stroke-linecap="round"/>
                <path d="M3 21H21" stroke="#818CF8" stroke-width="2" stroke-linecap="round"/>
                <circle cx="14" cy="12" r="1.5" fill="#38BDF8"/>
              </svg>
            </div>
            <input 
              type="text" 
              id="userRoom"
              name="entry.1456633297" 
              placeholder="Enter room number" 
              required 
            />
          </div>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
          <div class="spinner" id="btnSpinner"></div>
          <span id="btnText">Submit</span>
        </button>
      </form>

      <div class="success-modal" id="successModal">
        <div class="success-badge">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none">
            <path d="M20 6L9 17L4 12" stroke="#34D399" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="success-title">Thank You</h2>
      </div>

    </div>
  </div>

  <script>
    const form = document.getElementById('googleForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const successModal = document.getElementById('successModal');
    const hiddenIframe = document.getElementById('hidden_iframe');

    let isSubmitting = false;

    form.addEventListener('submit', function () {
      isSubmitting = true;
      submitBtn.disabled = true;
      btnText.textContent = 'Submitting...';
      btnSpinner.style.display = 'block';

      setTimeout(() => {
        if (isSubmitting) {
          showSuccessState();
        }
      }, 1200);
    });

    hiddenIframe.addEventListener('load', function () {
      if (isSubmitting) {
        showSuccessState();
      }
    });

    function showSuccessState() {
      isSubmitting = false;
      successModal.classList.add('active');
      form.reset();
    }

    const tiltCard = document.getElementById('tiltCard');
    document.addEventListener('mousemove', (e) => {
      if (window.innerWidth < 768) return;
      const rect = tiltCard.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const deltaX = (e.clientX - centerX) / 30;
      const deltaY = (centerY - e.clientY) / 30;
      tiltCard.style.transform = `rotateY(${Math.max(-7, Math.min(7, deltaX))}deg) rotateX(${Math.max(-7, Math.min(7, deltaY))}deg)`;
    });

    document.addEventListener('mouseleave', () => {
      tiltCard.style.transform = 'rotateY(0deg) rotateX(0deg)';
    });
  </script>
</body>
</html>
